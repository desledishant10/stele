/*
 * Stele protocol — Tamarin formal model
 *
 * Models the three security-critical protocol fragments and proves
 * their core security claims symbolically in the Dolev-Yao model.
 *
 * Coverage:
 *
 *   1. Forward-secure rotation (pkg/fwdsec):
 *      The operator key rotates through a chain of epochs. Compromise
 *      at epoch N+k must NOT allow forgery of a signature attributed
 *      to epoch N.  (Claim: forward_secrecy)
 *
 *   2. Witness mesh — fork detection (pkg/witness):
 *      Two checkpoints with the same size N but different roots can
 *      never both be cosigned by the same honest witness.  (Claim:
 *      no_witness_double_cosign)
 *
 *   3. Producer enrollment with proof-of-possession (pkg/core +
 *      pkg/storage/producers):
 *      An entry is accepted only when an active enrollment exists,
 *      signed by the operator AND by the producer over the operator's
 *      challenge.  (Claim: enrollment_required)
 *
 * The model is intentionally simplified to fit Tamarin's symbolic
 * solver:  we model signatures as ideal (no replay of identical
 * signature on different messages via the standard signing builtin),
 * hashes as collision-free, and the channel as Dolev-Yao (an
 * attacker controls the network).  Concrete implementations are
 * shown to instantiate the model soundly via the EUF-CMA properties
 * of Ed25519 / Dilithium3.
 *
 * To check the proofs (each lemma separately to avoid memory blow-up
 * on commodity hardware):
 *
 *   tamarin-prover --prove=enrollment_required        stele.spthy
 *   tamarin-prover --prove=forward_secrecy            stele.spthy
 *   tamarin-prover --prove=no_witness_double_cosign   stele.spthy
 *   tamarin-prover --prove=sanity_complete_run        stele.spthy
 *
 * See formal/expected-output.txt for the captured transcript.
 */

theory Stele
begin

builtins: signing, hashing


/* ---------------------------------------------------------------- *
 *  Restrictions                                                    *
 * ---------------------------------------------------------------- */

/* Standard equality restriction.  Combined with the signing
 * builtin's equation `verify(sign(m, sk), m, pk(sk)) = true`, an
 * action label `Eq(verify(sig, m, pk), true) @ t` forces the trace
 * to contain only valid signatures at that step. */
restriction Equality:
  "All x y #i. Eq(x, y) @ i ==> x = y"

/* A witness must not cosign two different roots at the same size.
 * Modeled by stamping every WitnessCosigned event with an
 * OnceAtSize(W, O, size) action; the restriction below pins those
 * actions to a single root. */
restriction WitnessSizeUnique:
  "All W O size r1 r2 #t1 #t2.
     OnceAtSize(W, O, size, r1) @ #t1
   & OnceAtSize(W, O, size, r2) @ #t2
   ==> r1 = r2"


/* ---------------------------------------------------------------- *
 *  1. Setup facts                                                  *
 *  Each fresh execution starts by minting long-term keypairs for   *
 *  the operator (genesis epoch), each witness, and each producer.  *
 * ---------------------------------------------------------------- */

/* The operator generates its genesis epoch keypair.  The persistent
 * fact !Operator(O, epoch, sk) records the key forever (for the
 * Reveal rule to use); the LINEAR fact Live(O, epoch, sk) is what
 * SignCheckpoint requires to fire and what Rotate destroys.
 *
 * !OperatorPubkey(O, epoch, pk(sk)) is the public-key registry that
 * witnesses consult when verifying checkpoints; it's persistent
 * because pubkeys are public knowledge forever. */
rule SetupOperator:
    [ Fr(~sk0) ]
  --[ OperatorGenesis(~sk0) ]->
    [ !Operator($O, 'epoch0', ~sk0),
      !OperatorPubkey($O, 'epoch0', pk(~sk0)),
      Live($O, 'epoch0', ~sk0),
      Out(pk(~sk0)) ]

/* Each witness has its own keypair. */
rule SetupWitness:
    [ Fr(~swk) ]
  --[ WitnessGenesis($W, ~swk) ]->
    [ !Witness($W, ~swk),
      Out(pk(~swk)) ]

/* Each producer mints its own keypair. */
rule SetupProducer:
    [ Fr(~spk) ]
  --[ ProducerGenesis($P, ~spk) ]->
    [ !ProducerKey($P, ~spk),
      Out(pk(~spk)) ]


/* ---------------------------------------------------------------- *
 *  2. Operator rotation (fwdsec)                                   *
 *                                                                  *
 *  Rotate consumes the LINEAR Live(O, epoch_old, sk_old) fact,     *
 *  which is the "destruction" of the old key:  after this rule     *
 *  fires, no honest SignCheckpoint event can refer to sk_old       *
 *  again (because there's no Live fact to consume).  The adversary *
 *  can still recover sk_old via Reveal — see below — and can sign  *
 *  arbitrary bytes with it, but the SignCheckpoint ACTION FACT     *
 *  (which is what the lemma quantifies over) is honest-only.       *
 *                                                                  *
 *  A new Live and !OperatorPubkey are minted for the new epoch.    *
 * ---------------------------------------------------------------- */

rule Rotate:
    let
        rotcert = sign(<'rotcert', epoch_new, pk(~sk_new)>, sk_old)
    in
    [ Live(O, epoch_old, sk_old),
      Fr(~sk_new),
      In(epoch_new)
    ]
  --[ RotateFrom(O, epoch_old, sk_old),
      RotateTo(O, epoch_new, ~sk_new),
      ChainLink(epoch_old, epoch_new, pk(~sk_new), rotcert) ]->
    [ !Operator(O, epoch_new, ~sk_new),
      !OperatorPubkey(O, epoch_new, pk(~sk_new)),
      Live(O, epoch_new, ~sk_new),
      Out(<epoch_old, epoch_new, pk(~sk_new), rotcert>) ]


/* ---------------------------------------------------------------- *
 *  3. Operator signs checkpoint                                    *
 *                                                                  *
 *  Consumes Live (the linear "I am the active key" token), signs,  *
 *  and re-emits Live so the same key can sign another checkpoint.  *
 *  After a Rotate, the old Live is gone — so SignCheckpoint can    *
 *  no longer fire with sk_old, which is what makes forward         *
 *  secrecy provable.                                               *
 * ---------------------------------------------------------------- */

rule SignCheckpoint:
    let
        ckpt = sign(<'ckpt', size, root, epoch>, sk)
    in
    [ Live(O, epoch, sk),
      In(<size, root>)
    ]
  --[ CheckpointSigned(O, epoch, size, root, sk) ]->
    [ Live(O, epoch, sk),
      Out(<O, epoch, size, root, ckpt>) ]


/* ---------------------------------------------------------------- *
 *  4. Witness countersigns                                         *
 *                                                                  *
 *  The witness verifies the operator's checkpoint signature using  *
 *  the public key registry (!OperatorPubkey), and records the      *
 *  (size, root) pair.  The OnceAtSize restriction enforces that    *
 *  a single witness cannot stamp two different roots at the same   *
 *  size — that's the fork-detection guarantee.                     *
 * ---------------------------------------------------------------- */

rule WitnessFirstCosign:
    let
        cosig = sign(<'witness', O, size, root, epoch>, swk)
    in
    [ !Witness(W, swk),
      !OperatorPubkey(O, epoch, opk),
      In(<O, epoch, size, root, ckpt>)
    ]
  --[ Eq(verify(ckpt, <'ckpt', size, root, epoch>, opk), true),
      OnceAtSize(W, O, size, root),
      WitnessCosigned(W, O, size, root, swk) ]->
    [ Out(<W, O, size, root, cosig>) ]


/* ---------------------------------------------------------------- *
 *  5. Producer enrollment (proof-of-possession ceremony)           *
 *                                                                  *
 *  Step 1 — Begin:  operator receives the producer's pubkey and    *
 *                   identity from the network and issues a fresh   *
 *                   challenge.  Operator does NOT learn spk; only  *
 *                   the public key pk(spk).                        *
 *  Step 2 — Confirm: operator receives the producer's signature    *
 *                    on the challenge; verifies it.  On success    *
 *                    operator signs the enrollment record with     *
 *                    its chain key.                                *
 *                                                                  *
 *  Both signatures are required and bound to the same identity.    *
 * ---------------------------------------------------------------- */

/* The operator's view of EnrollBegin: opaque producer_pk + P
 * arrive from the network.  The operator never has access to spk
 * in this rule — the previous model erroneously had a `let
 * producer_pk = pk(spk)` which made spk implicitly adversary-
 * controlled (the wellformedness warning).
 *
 * Live is required + re-emitted so this rule only fires while
 * the operator is alive at its current epoch.  This is also what
 * makes operator-side compromise via Reveal exclusive of enrollment
 * activity. */
rule EnrollBegin:
    [ Live(O, epoch, sk),
      Fr(~challenge),
      In(<producer_pk, P>)
    ]
  --[ ChallengeIssued(O, P, producer_pk, ~challenge) ]->
    [ Live(O, epoch, sk),
      !PendingEnroll(O, epoch, sk, P, producer_pk, ~challenge),
      Out(~challenge) ]

/* EnrollConfirm models BOTH parties:  the producer constructs
 * pop_sig under spk (bound here by !ProducerKey), the operator
 * verifies it against pk(spk) (bound by !PendingEnroll's stored
 * producer_pk which must equal pk(spk) for the rule to match),
 * and the operator emits the signed enrollment artifact.
 *
 * !PendingEnroll is consumed implicitly because we pattern-match
 * on it as persistent — that's intentional; in real stele a
 * second EnrollConfirm on the same challenge produces the same
 * artifact, which the operator's replay table dedups. */
rule EnrollConfirm:
    let
        pop_sig    = sign(challenge, spk)
        enrollment = sign(<'enroll', P, pk(spk), scope>, sk)
    in
    [ !PendingEnroll(O, epoch, sk, P, pk(spk), challenge),
      !ProducerKey(P, spk),
      In(scope)
    ]
  --[ Eq(verify(pop_sig, challenge, pk(spk)), true),
      EnrollmentConfirmed(O, P, pk(spk), scope, sk, spk) ]->
    [ !Enrollment(O, P, pk(spk), scope, enrollment),
      Out(enrollment) ]


/* ---------------------------------------------------------------- *
 *  6. Producer submits an entry                                    *
 *                                                                  *
 *  AppendEntry receives an opaque envelope_sig from the network.   *
 *  The operator looks up the producer's enrollment to recover the  *
 *  enrolled pubkey, and verifies the signature against that key.   *
 *  If the signature checks out, EntryAccepted fires.               *
 *                                                                  *
 *  Critically: spk does NOT appear in this rule.  The operator     *
 *  has no access to the producer's private key.  Only the          *
 *  signature on the envelope is needed.                            *
 * ---------------------------------------------------------------- */

rule AppendEntry:
    [ Live(O, epoch, sk),
      !Enrollment(O, P, producer_pk, scope, enrollment),
      In(<data, time, envelope_sig>)
    ]
  --[ Eq(verify(envelope_sig, <'envelope', P, data, time>, producer_pk), true),
      EntryAccepted(O, P, data, time, producer_pk) ]->
    [ Live(O, epoch, sk),
      Out(<O, P, data, time, envelope_sig>) ]


/* ---------------------------------------------------------------- *
 *  7. Compromise: the adversary learns a long-term secret          *
 *                                                                  *
 *  RevealOperatorKey consumes Live, modeling the threat as:        *
 *  "the adversary compromises the operator host, learning the      *
 *  active key, and the honest operator stops signing checkpoints   *
 *  under that key from this point on."  This is what makes         *
 *  forward_secrecy provable:  any CheckpointSigned action for      *
 *  (O, epoch, sk) must have happened BEFORE the Reveal of that     *
 *  same key, because after Reveal there's no Live token to fire    *
 *  the rule.                                                       *
 *                                                                  *
 *  Producer + witness reveals leave their persistent !facts in     *
 *  place since those parties have no Live notion.                  *
 * ---------------------------------------------------------------- */

rule RevealOperatorKey:
    [ Live(O, epoch, sk) ]
  --[ Reveal(O, epoch, sk) ]->
    [ Out(sk) ]

rule RevealWitnessKey:
    [ !Witness(W, swk) ]
  --[ RevealWitness(W, swk) ]->
    [ Out(swk) ]

rule RevealProducerKey:
    [ !ProducerKey(P, spk) ]
  --[ RevealProducer(P, spk) ]->
    [ Out(spk) ]


/* ================================================================ *
 *                           SECURITY LEMMAS                        *
 * ================================================================ */

/* ----  Lemma 1: forward secrecy of past epochs  ---- *
 *
 * If a checkpoint for (size, root) is signed by epoch N's key, and
 * the attacker LATER reveals (or has revealed) that epoch's key,
 * then the honest CheckpointSigned event MUST have happened first.
 * Equivalently:  after Reveal, no honest CheckpointSigned for that
 * key is possible (because Reveal consumed Live).
 */

lemma forward_secrecy:
  "All O epoch size root sk #t1 #t2.
     CheckpointSigned(O, epoch, size, root, sk) @ #t1
   & Reveal(O, epoch, sk) @ #t2
   ==>
     #t1 < #t2"


/* ----  Lemma 2: no honest witness ever cosigns two roots at the same size  ----
 *
 * The WitnessSizeUnique restriction makes this trivially true at
 * the rule level; the lemma here makes the trace-level claim
 * explicit.  An honest witness whose key has NOT been revealed
 * cannot have signed two roots at the same size for the same
 * operator.
 */

lemma no_witness_double_cosign:
  "All W O size root1 root2 swk #t1 #t2.
     WitnessCosigned(W, O, size, root1, swk) @ #t1
   & WitnessCosigned(W, O, size, root2, swk) @ #t2
   & not(root1 = root2)
   ==>
     Ex #r. RevealWitness(W, swk) @ #r"


/* ----  Lemma 3: an entry is accepted only when the producer is enrolled  ----
 *
 * Every EntryAccepted(O, P, ...) action must be preceded by an
 * EnrollmentConfirmed(O, P, ...) action for the SAME producer
 * with the SAME pubkey.
 */

lemma enrollment_required:
  "All O P data time producer_pk #t.
     EntryAccepted(O, P, data, time, producer_pk) @ #t
   ==>
     Ex scope sk spk #t_enroll.
       EnrollmentConfirmed(O, P, producer_pk, scope, sk, spk) @ #t_enroll
     & #t_enroll < #t"


/* ----  Sanity lemma: an honest run is possible  ----
 *
 * Without this, the lemmas above could vacuously hold simply because
 * no protocol run completes.  This lemma asserts there is AT LEAST
 * ONE trace where an enrolled producer's entry is accepted and a
 * witness cosigns a checkpoint.
 */

lemma sanity_complete_run:
  exists-trace
  "Ex O sk W swk P data time spk producer_pk scope #r1 #r2 #r3 #r4 #r5.
       OperatorGenesis(sk) @ #r1
     & WitnessGenesis(W, swk) @ #r2
     & ProducerGenesis(P, spk) @ #r3
     & EnrollmentConfirmed(O, P, producer_pk, scope, sk, spk) @ #r4
     & EntryAccepted(O, P, data, time, producer_pk) @ #r5"

end
