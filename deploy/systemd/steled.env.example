# /etc/stele/steled.env — example environment for the steled service.
# Copy to /etc/stele/steled.env and edit; permissions should be
# 0640 root:stele.

# Listening address. Use --tls-cert/--tls-key under STELE_FLAGS for
# HTTPS; pair with --client-ca for mTLS.
STELE_ADDR=:8080

# The log's stable identity. Must be unique per operator instance.
STELE_ORIGIN=stele.example.com/audit

# Structured-JSON logging on stdout/stderr → journald.
STELE_LOG_FORMAT=json
STELE_LOG_LEVEL=info

# Optional: HSM PIN if --hsm-module is used.
# STELE_HSM_PIN=replace-me

# Full operator flag list. Sane defaults for an enrollment-enforcing,
# tripwire-on production deployment. Add/remove flags as needed.
STELE_FLAGS=--init \
  --require-enrollment \
  --pq-mode=classical \
  --checkpoint-every=30s \
  --anchor-every=30s \
  --rotate-every=1h \
  --watch-keys=true \
  --watch-rate=false \
  --read-log=true \
  --tripwire-every=1h \
  --max-concurrent-appends=256 \
  --per-producer-rps=100 \
  --per-producer-burst=200 \
  --per-admin-rps=5 \
  --per-admin-burst=10
