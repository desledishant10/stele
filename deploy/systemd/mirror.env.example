# /etc/stele/mirror.env — example environment for stele-mirror.service.

STELE_MIRROR_ADDR=:8444
STELE_MIRROR_UPSTREAM=https://stele.example.com:8443
STELE_LOG_FORMAT=json
STELE_LOG_LEVEL=info

# `--poll` controls how often the mirror pulls new entries. 30s is a
# reasonable production default; faster polling gives lower lag at
# the cost of operator load.
STELE_MIRROR_FLAGS=--poll=30s
