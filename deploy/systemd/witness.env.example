# /etc/stele/witness.env — example environment for stele-witness.service.

STELE_WITNESS_ADDR=:9090
STELE_WITNESS_ID=witness-a
STELE_LOG_FORMAT=json
STELE_LOG_LEVEL=info

# Add --pq-mode=hybrid if the operator chain is hybrid.
# --gossip-every is what makes the witness mesh self-detect forks;
# 30s is a reasonable production value.
STELE_WITNESS_FLAGS=--gossip-every=30s
